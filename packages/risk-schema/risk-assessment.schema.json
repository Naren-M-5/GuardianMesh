{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardianmesh.dev/schemas/risk-assessment-1.0.json",
  "title": "RiskAssessment",
  "type": "object",
  "required": ["risk_assessment_id", "incident_id", "score", "level", "evidence", "model_confidence", "created_at"],
  "properties": {
    "risk_assessment_id": {"type": "string", "pattern": "^risk_"},
    "incident_id": {"type": "string", "pattern": "^inc_"},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "level": {"enum": ["normal", "watch", "suspicious", "high"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "weight", "value", "explanation"],
        "properties": {
          "code": {"type": "string"},
          "weight": {"type": "integer", "minimum": 0},
          "value": {"type": "number", "minimum": 0, "maximum": 1},
          "explanation": {"type": "string"}
        }
      }
    },
    "model_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
